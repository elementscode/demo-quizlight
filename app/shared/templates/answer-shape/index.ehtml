export const ANSWER_NAMES = ["triangle", "diamond", "circle", "square"];

<AnswerShape (index: number, size: number = 24)>
  <svg class="answer-shape" width={size} height={size} viewBox="0 0 24 24" role="img" aria-label={ANSWER_NAMES[index]}>
    <path e:if={index === 0} d="M12 3 L22 20 H2 Z" fill="currentColor"/>
    <path e:elseif={index === 1} d="M12 2 L22 12 L12 22 L2 12 Z" fill="currentColor"/>
    <circle e:elseif={index === 2} cx="12" cy="12" r="10" fill="currentColor"/>
    <rect e:else x="3" y="3" width="18" height="18" rx="2" fill="currentColor"/>
  </svg>
</AnswerShape>
