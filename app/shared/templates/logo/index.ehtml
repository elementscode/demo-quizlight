<Logo (size: number = 24)>
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="6" fill="var(--accent)"/>
    <path d="M7 9.5 L12 5 L17 9.5" stroke="var(--answer-2)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <circle cx="12" cy="14.5" r="4" fill="#ffffff"/>
  </svg>
</Logo>
