import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { Field } from "@elements/ui/field";
import { Card, CardContent } from "@elements/ui/card";
import { Alert, AlertTitle, AlertDescription } from "@elements/ui/alert";
import { signin, DEMO_HOST } from "#app/shared/services/auth";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/quizzes");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUseDemo(form: SigninForm) {
  form.email = DEMO_HOST.email;
  form.password = DEMO_HOST.password;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <Layout title="Host sign in">
    <div class="stack is-xl">
      <form class="signin-card" onsubmit={() => onSubmit(form)}>
        <Card>
          <CardContent class="stack">
            <h1>Host sign in</h1>

            <Alert e:if={form.error} variant="danger" description={form.error} />

            <Field label="email">
              <Input value={form.email}
                     name="email"
                     type="email"
                     placeholder="you@example.com"
                     required
                     attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="password">
              <Input value={form.password}
                     name="password"
                     type="password"
                     required
                     attrs={{ id: "password", autocomplete: "current-password" }} />
            </Field>

            <Button type="submit" variant="primary" block>sign in</Button>

            <p class="hint">New host? <a href="/signup">Create an account</a></p>
          </CardContent>
        </Card>
      </form>

      <Alert variant="accent" role="none" class="signin-demo">
        <AlertTitle>Demo host</AlertTitle>
        <AlertDescription class="stack is-sm">
          <p>Three quizzes are ready to play: geography, movies and science.</p>
          <dl>
            <dt>email</dt>
            <dd>{DEMO_HOST.email}</dd>
            <dt>password</dt>
            <dd>{DEMO_HOST.password}</dd>
          </dl>
          <div>
            <Button size="sm" onclick={() => onUseDemo(form)}>sign in as the demo host</Button>
          </div>
        </AlertDescription>
      </Alert>
    </div>
  </Layout>
</html>
