import "./style.css";
import { session, redirect, ValidationError, FieldErrors } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { Field } from "@elements/ui/field";
import { Card, CardContent } from "@elements/ui/card";
import { Alert } from "@elements/ui/alert";
import { joinGame, JoinForm, MAX_NICKNAME } from "#app/shared/services/game";

interface JoinState {
  form: JoinForm;
  errors: FieldErrors<JoinForm>;
  error: string;
  joining: boolean;
}

function onSubmit(state: JoinState) {
  state.joining = true;

  try {
    let token = joinGame(state.form);
    state.errors = {};
    state.error = "";
    redirect(`/play/${token}`);
  } catch (err: any) {
    state.joining = false;

    if (err instanceof ValidationError && err.errors) {
      state.errors = err.errors;
      state.error = "";
    } else {
      state.errors = {};
      state.error = err.message;
    }
  }
}

<html lang="en" class="page-home" (
  code: string = "",
  private state: JoinState = { form: { code, nickname: "" }, errors: {}, error: "", joining: false },
)>
  <Layout title="Join a game">
    <div slot="nav" class="cluster is-sm">
      <Button e:if={session.isLoggedIn()} href="/quizzes" variant="ghost" size="sm">my quizzes</Button>
      <Button e:else href="/signin" variant="ghost" size="sm">host sign in</Button>
    </div>

    <div class="stack is-2xl">
      <div class="home-hero stack is-sm">
        <p class="eyebrow">game night</p>
        <h1 class="display">Join the quiz</h1>
        <p class="lede">Type the code from the big screen and pick a name.</p>
      </div>

      <form class="home-join" onsubmit={() => onSubmit(state)}>
        <Card>
          <CardContent class="stack">
            <Alert e:if={state.error} variant="danger" description={state.error} />

            <Field label="game code" error={state.errors.code?.[0] ?? ""}>
              <Input value={state.form.code}
                     name="code"
                     class="home-code"
                     size="lg"
                     placeholder="000000"
                     required
                     attrs={{ id: "code", inputmode: "numeric", autocomplete: "off", maxlength: 7 }} />
            </Field>

            <Field label="nickname" error={state.errors.nickname?.[0] ?? ""}>
              <Input value={state.form.nickname}
                     name="nickname"
                     size="lg"
                     placeholder="Quizzy McQuizface"
                     required
                     attrs={{ id: "nickname", autocomplete: "nickname", autocapitalize: "words", maxlength: MAX_NICKNAME }} />
            </Field>

            <Button type="submit" variant="primary" size="lg" block loading={state.joining}>join game</Button>
          </CardContent>
        </Card>
      </form>

      <p class="home-host cluster is-sm">
        Hosting tonight?
        <a class="link-action" href="/quizzes">Run a quiz on the big screen</a>
      </p>
    </div>
  </Layout>
</html>
