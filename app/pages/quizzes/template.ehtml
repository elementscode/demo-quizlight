import "./style.css";
import { session, redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { QuizSummary, createQuiz } from "#app/shared/services/quizzes";
import { startGame } from "#app/shared/services/game";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Alert } from "@elements/ui/alert";
import { Empty } from "@elements/ui/empty";

export interface LiveGame {
  id: string;
  code: string;
  title: string;
}

interface Busy {
  id: string;
  error: string;
}

function onStart(busy: Busy, quiz: QuizSummary) {
  busy.id = quiz.id;
  busy.error = "";

  try {
    redirect(`/host/${startGame(quiz.id)}`);
  } catch (err: any) {
    busy.id = "";
    busy.error = err.message;
  }
}

function onCreate(busy: Busy) {
  try {
    redirect(`/quizzes/${createQuiz()}`);
  } catch (err: any) {
    busy.error = err.message;
  }
}

<html lang="en" class="page-quizzes" (
  quizzes: QuizSummary[],
  live: LiveGame[],
  private busy: Busy = { id: "", error: "" },
)>
  <Layout title="Your quizzes">
    <div slot="nav" class="cluster is-sm">
      <span class="text-sm">{session.get("userName")}</span>
      <Button href="/signout" variant="ghost" size="sm">sign out</Button>
    </div>

    <div class="stack is-xl">
      <div class="quizzes-head row">
        <div class="stack is-xs">
          <p class="eyebrow">host</p>
          <h1>Your quizzes</h1>
        </div>
        <Button variant="primary" onclick={() => onCreate(busy)}>new quiz</Button>
      </div>

      <Alert e:for={game of live} variant="accent" role="none">
        <div class="quizzes-live row">
          <span><strong>{game.title}</strong> is still running, code <span class="quizzes-code">{game.code}</span></span>
          <Button href={`/host/${game.id}`} size="sm">back to the big screen</Button>
        </div>
      </Alert>

      <Alert e:if={busy.error} variant="danger" description={busy.error} />

      <ul e:if={quizzes.length > 0} class="quizzes-list">
        <li e:for={quiz of quizzes}>
          <Card class="quizzes-item">
            <CardContent>
              <div class="stack is-xs">
                <h2>{quiz.title}</h2>
                <p e:if={quiz.blurb} class="quizzes-meta">{quiz.blurb}</p>
                <p class="quizzes-meta">{quiz.questionCount} {quiz.questionCount === 1 ? "question" : "questions"}</p>
              </div>
              <div class="quizzes-actions cluster is-sm">
                <Button href={`/quizzes/${quiz.id}`} variant="ghost">edit</Button>
                <Button variant="primary"
                        loading={busy.id === quiz.id}
                        disabled={quiz.questionCount === 0}
                        onclick={() => onStart(busy, quiz)}>
                  start game
                </Button>
              </div>
            </CardContent>
          </Card>
        </li>
      </ul>

      <Empty e:else variant="outline" title="No quizzes yet" description="Make one and it will show up here." />
    </div>
  </Layout>
</html>
