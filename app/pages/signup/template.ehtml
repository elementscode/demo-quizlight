import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { Field } from "@elements/ui/field";
import { Card, CardContent } from "@elements/ui/card";
import { Alert } from "@elements/ui/alert";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/quizzes");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <Layout title="Create a host account">
    <form class="signup-card" onsubmit={() => onSubmit(form)}>
      <Card>
        <CardContent class="stack">
          <h1>Become a host</h1>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <Field label="name">
            <Input value={form.name} name="name" required attrs={{ id: "name", autocomplete: "name" }} />
          </Field>

          <Field label="email">
            <Input value={form.email}
                   name="email"
                   type="email"
                   placeholder="you@example.com"
                   required
                   attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
          </Field>

          <Field label="password" description={`at least ${MIN_PASSWORD} characters`}>
            <Input value={form.password}
                   name="password"
                   type="password"
                   required
                   attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
          </Field>

          <Button type="submit" variant="primary" block>create account</Button>

          <p class="hint">Already hosting? <a href="/signin">Sign in</a></p>
        </CardContent>
      </Card>
    </form>
  </Layout>
</html>
