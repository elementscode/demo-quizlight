import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { AnswerShape } from "#app/shared/templates/answer-shape";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { NumberInput } from "@elements/ui/number-input";
import { Textarea } from "@elements/ui/textarea";
import { Card, CardContent } from "@elements/ui/card";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import {
  Quiz,
  Question,
  MIN_TIME,
  MAX_TIME,
  saveQuiz,
  addQuestion,
  saveQuestion,
  deleteQuestion,
  deleteQuiz,
} from "#app/shared/services/quizzes";
import { startGame } from "#app/shared/services/game";

type AnswerKey = "answerA" | "answerB" | "answerC" | "answerD";

const ANSWER_KEYS: AnswerKey[] = ["answerA", "answerB", "answerC", "answerD"];

interface Status {
  text: string;
  error: string;
}

function saved(status: Status) {
  status.text = "all changes saved";
  status.error = "";
}

function failed(status: Status, err: any) {
  status.text = "";
  status.error = err.message;
}

function onQuizChange(status: Status, quiz: Quiz) {
  try {
    saveQuiz(quiz);
    saved(status);
  } catch (err: any) {
    failed(status, err);
  }
}

function onQuestionChange(status: Status, question: Question) {
  try {
    saveQuestion(question);
    saved(status);
  } catch (err: any) {
    failed(status, err);
  }
}

function onMarkCorrect(status: Status, question: Question, index: number) {
  question.correct = index;
  onQuestionChange(status, question);
}

function onAdd(status: Status, quiz: Quiz, questions: Question[]) {
  try {
    questions.push(addQuestion(quiz.id));
    saved(status);
  } catch (err: any) {
    failed(status, err);
  }
}

function onDelete(status: Status, questions: Question[], question: Question) {
  let at = questions.indexOf(question);

  if (at >= 0) {
    questions.splice(at, 1);
  }

  try {
    deleteQuestion(question.id);
    saved(status);
  } catch (err: any) {
    failed(status, err);
  }
}

function onDeleteQuiz(quiz: Quiz) {
  deleteQuiz(quiz.id);
  redirect("/quizzes");
}

function onStart(status: Status, quiz: Quiz) {
  try {
    redirect(`/host/${startGame(quiz.id)}`);
  } catch (err: any) {
    failed(status, err);
  }
}

<html lang="en" class="page-quiz-edit" (
  quiz: Quiz,
  questions: Question[],
  private status: Status = { text: "", error: "" },
)>
  <Layout title={quiz.title}>
    <div slot="nav" class="cluster is-sm">
      <Button href="/quizzes" variant="ghost" size="sm">my quizzes</Button>
    </div>

    <div class="stack is-xl">
      <div class="edit-top row">
        <a href="/quizzes" class="link-muted">← all quizzes</a>
        <div class="cluster is-sm">
          <span class="edit-status" aria-live="polite">{status.text}</span>
          <Button variant="primary" disabled={questions.length === 0} onclick={() => onStart(status, quiz)}>start game</Button>
        </div>
      </div>

      <Alert e:if={status.error} variant="danger" description={status.error} />

      <div class="stack is-sm">
        <Input value={quiz.title}
               class="edit-title"
               size="lg"
               placeholder="Quiz title"
               attrs={{ "aria-label": "quiz title" }}
               onchange={() => onQuizChange(status, quiz)} />
        <Input value={quiz.blurb}
               placeholder="A line about this quiz (optional)"
               attrs={{ "aria-label": "description" }}
               onchange={() => onQuizChange(status, quiz)} />
      </div>

      <ol class="edit-questions">
        <li e:for={[n, question] of questions.entries()} e:key={([n, question]) => question.id}>
          <Card>
            <CardContent class="stack">
              <div class="edit-question-head row">
                <span class="edit-number">Question {n + 1}</span>
                <div class="cluster is-sm">
                  <label class="edit-time row">
                    <NumberInput value={question.timeLimit}
                                 size="sm"
                                 buttons="end"
                                 min={MIN_TIME}
                                 max={MAX_TIME}
                                 step={5}
                                 attrs={{ "aria-label": `question ${n + 1} time limit in seconds` }}
                                 onValueCommit={() => onQuestionChange(status, question)} />
                    seconds
                  </label>
                  <Button variant="ghost" size="sm" onclick={() => onDelete(status, questions, question)}>delete</Button>
                </div>
              </div>

              <Textarea value={question.prompt}
                        rows={1}
                        resize="none"
                        placeholder="Ask a question"
                        attrs={{ "aria-label": `question ${n + 1}` }}
                        onchange={() => onQuestionChange(status, question)} />

              <div class="edit-answers">
                <div e:for={[i, key] of ANSWER_KEYS.entries()}
                     e:key={([i]) => i}
                     class={["edit-answer", `is-answer-${i}`, question.correct === i && "is-correct"]}>
                  <AnswerShape index={i} size={18} />
                  <Input value={question[key]}
                         placeholder={`Answer ${i + 1}`}
                         attrs={{ "aria-label": `answer ${i + 1}` }}
                         onchange={() => onQuestionChange(status, question)} />
                  <Button e:if={question.correct === i} class="edit-mark" size="sm" variant="primary" attrs={{ "aria-pressed": "true" }}>✓ correct</Button>
                  <Button e:else class="edit-mark" size="sm" variant="ghost" onclick={() => onMarkCorrect(status, question, i)}>mark correct</Button>
                </div>
              </div>
            </CardContent>
          </Card>
        </li>
      </ol>

      <div class="edit-foot row">
        <Button onclick={() => onAdd(status, quiz, questions)}>+ add question</Button>
        <AlertDialog title={`Delete "${quiz.title}"?`} description="This deletes the quiz and all of its questions.">
          <Button slot="trigger" variant="danger" size="sm">delete quiz</Button>
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" onclick={() => onDeleteQuiz(quiz)}>Delete quiz</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </div>
    </div>
  </Layout>
</html>
